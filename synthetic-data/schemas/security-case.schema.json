{
  "additionalProperties": false,
  "properties": {
    "attack_type": {
      "enum": [
        "cross_tenant",
        "role_spoofing",
        "prompt_injection",
        "secret_exfiltration",
        "fake_citation",
        "unapproved_write",
        "pii_exfiltration",
        "tool_result_injection"
      ],
      "title": "Attack Type",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "const": "synthetic-commerce-v1",
      "title": "Dataset Version",
      "type": "string"
    },
    "expected_action": {
      "enum": [
        "deny",
        "refuse",
        "ignore_instruction"
      ],
      "title": "Expected Action",
      "type": "string"
    },
    "forbidden_outputs": {
      "items": {
        "type": "string"
      },
      "title": "Forbidden Outputs",
      "type": "array"
    },
    "input_text": {
      "title": "Input Text",
      "type": "string"
    },
    "is_synthetic": {
      "const": true,
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "synthetic-record-v1",
      "default": "synthetic-record-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "security_case_id": {
      "title": "Security Case Id",
      "type": "string"
    },
    "source": {
      "const": "fake",
      "default": "fake",
      "title": "Source",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^synthetic-[a-z0-9-]+$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "scenario_id",
    "tenant_id",
    "security_case_id",
    "attack_type",
    "input_text",
    "expected_action",
    "forbidden_outputs"
  ],
  "title": "SecurityCaseRecord",
  "type": "object"
}
