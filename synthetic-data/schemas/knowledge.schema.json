{
  "additionalProperties": false,
  "properties": {
    "authority": {
      "enum": [
        "official",
        "department",
        "reference"
      ],
      "title": "Authority",
      "type": "string"
    },
    "contains_prompt_injection": {
      "default": false,
      "title": "Contains Prompt Injection",
      "type": "boolean"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "const": "synthetic-commerce-v1",
      "title": "Dataset Version",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "evidence_anchor_id": {
      "title": "Evidence Anchor Id",
      "type": "string"
    },
    "is_synthetic": {
      "const": true,
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "relative_path": {
      "title": "Relative Path",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "synthetic-record-v1",
      "default": "synthetic-record-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "const": "fake",
      "default": "fake",
      "title": "Source",
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "active",
        "expired",
        "inactive",
        "deleted"
      ],
      "title": "Status",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^synthetic-[a-z0-9-]+$",
      "title": "Tenant Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "topic": {
      "enum": [
        "product",
        "invoice",
        "membership",
        "logistics",
        "returns",
        "support",
        "privacy",
        "region",
        "channel",
        "time"
      ],
      "title": "Topic",
      "type": "string"
    },
    "valid_from": {
      "format": "date-time",
      "title": "Valid From",
      "type": "string"
    },
    "valid_until": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Valid Until"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "scenario_id",
    "tenant_id",
    "document_id",
    "title",
    "topic",
    "version",
    "status",
    "authority",
    "evidence_anchor_id",
    "relative_path",
    "content_sha256",
    "valid_from",
    "valid_until"
  ],
  "title": "KnowledgeRecord",
  "type": "object"
}
