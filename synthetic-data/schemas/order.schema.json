{
  "$defs": {
    "OrderLine": {
      "additionalProperties": false,
      "properties": {
        "line_id": {
          "title": "Line Id",
          "type": "string"
        },
        "product_id": {
          "title": "Product Id",
          "type": "string"
        },
        "quantity": {
          "maximum": 20,
          "minimum": 1,
          "title": "Quantity",
          "type": "integer"
        },
        "returnable": {
          "title": "Returnable",
          "type": "boolean"
        },
        "sku": {
          "title": "Sku",
          "type": "string"
        },
        "subtotal": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
              "type": "string"
            }
          ],
          "title": "Subtotal"
        },
        "unit_price": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
              "type": "string"
            }
          ],
          "title": "Unit Price"
        }
      },
      "required": [
        "line_id",
        "product_id",
        "sku",
        "quantity",
        "unit_price",
        "subtotal",
        "returnable"
      ],
      "title": "OrderLine",
      "type": "object"
    },
    "StatePoint": {
      "additionalProperties": false,
      "properties": {
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "occurred_at"
      ],
      "title": "StatePoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "address_snapshot": {
      "const": "测试省/演示市/样例区/***路***号",
      "title": "Address Snapshot",
      "type": "string"
    },
    "currency": {
      "const": "CNY",
      "default": "CNY",
      "title": "Currency",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "const": "synthetic-commerce-v1",
      "title": "Dataset Version",
      "type": "string"
    },
    "discount": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
          "type": "string"
        }
      ],
      "title": "Discount"
    },
    "high_value": {
      "title": "High Value",
      "type": "boolean"
    },
    "is_synthetic": {
      "const": true,
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/OrderLine"
      },
      "minItems": 1,
      "title": "Lines",
      "type": "array"
    },
    "order_id": {
      "title": "Order Id",
      "type": "string"
    },
    "owner_user_id": {
      "title": "Owner User Id",
      "type": "string"
    },
    "refunded_amount": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
          "type": "string"
        }
      ],
      "title": "Refunded Amount"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "synthetic-record-v1",
      "default": "synthetic-record-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "shipping_fee": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
          "type": "string"
        }
      ],
      "title": "Shipping Fee"
    },
    "source": {
      "const": "fake",
      "default": "fake",
      "title": "Source",
      "type": "string"
    },
    "status": {
      "enum": [
        "created",
        "paid",
        "allocated",
        "shipped",
        "delivered",
        "closed",
        "cancelled",
        "refund_pending"
      ],
      "title": "Status",
      "type": "string"
    },
    "status_history": {
      "items": {
        "$ref": "#/$defs/StatePoint"
      },
      "minItems": 1,
      "title": "Status History",
      "type": "array"
    },
    "subtotal": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
          "type": "string"
        }
      ],
      "title": "Subtotal"
    },
    "tax": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
          "type": "string"
        }
      ],
      "title": "Tax"
    },
    "tenant_id": {
      "pattern": "^synthetic-[a-z0-9-]+$",
      "title": "Tenant Id",
      "type": "string"
    },
    "total": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
          "type": "string"
        }
      ],
      "title": "Total"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "scenario_id",
    "tenant_id",
    "order_id",
    "owner_user_id",
    "status",
    "lines",
    "subtotal",
    "discount",
    "shipping_fee",
    "tax",
    "total",
    "refunded_amount",
    "address_snapshot",
    "high_value",
    "status_history"
  ],
  "title": "OrderRecord",
  "type": "object"
}
