{
  "additionalProperties": false,
  "properties": {
    "dataset_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "const": "synthetic-commerce-v1",
      "title": "Dataset Version",
      "type": "string"
    },
    "is_synthetic": {
      "const": true,
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "isolation_policy": {
      "enum": [
        "logical",
        "dedicated"
      ],
      "title": "Isolation Policy",
      "type": "string"
    },
    "quotas": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Quotas",
      "type": "object"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "synthetic-record-v1",
      "default": "synthetic-record-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "const": "fake",
      "default": "fake",
      "title": "Source",
      "type": "string"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "disabled"
      ],
      "title": "Status",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^synthetic-[a-z0-9-]+$",
      "title": "Tenant Id",
      "type": "string"
    },
    "tenant_name": {
      "title": "Tenant Name",
      "type": "string"
    },
    "tier": {
      "enum": [
        "standard",
        "enterprise",
        "regulated"
      ],
      "title": "Tier",
      "type": "string"
    },
    "timezone": {
      "const": "Asia/Shanghai",
      "default": "Asia/Shanghai",
      "title": "Timezone",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "scenario_id",
    "tenant_id",
    "tenant_name",
    "tier",
    "isolation_policy",
    "quotas"
  ],
  "title": "TenantRecord",
  "type": "object"
}
