{
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "title": "Approval Id",
      "type": "string"
    },
    "approver_role": {
      "const": "supervisor",
      "title": "Approver Role",
      "type": "string"
    },
    "approver_user_id": {
      "title": "Approver User Id",
      "type": "string"
    },
    "callback_idempotency_key": {
      "title": "Callback Idempotency Key",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "const": "synthetic-commerce-v1",
      "title": "Dataset Version",
      "type": "string"
    },
    "decided_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Decided At"
    },
    "decision_reason": {
      "title": "Decision Reason",
      "type": "string"
    },
    "draft_version": {
      "minimum": 1,
      "title": "Draft Version",
      "type": "integer"
    },
    "is_synthetic": {
      "const": true,
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "policy_version": {
      "const": "synthetic-refund-policy-v1",
      "title": "Policy Version",
      "type": "string"
    },
    "refund_id": {
      "title": "Refund Id",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "synthetic-record-v1",
      "default": "synthetic-record-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "const": "fake",
      "default": "fake",
      "title": "Source",
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "approved",
        "rejected",
        "expired",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^synthetic-[a-z0-9-]+$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "scenario_id",
    "tenant_id",
    "approval_id",
    "refund_id",
    "draft_version",
    "policy_version",
    "status",
    "approver_user_id",
    "approver_role",
    "decision_reason",
    "callback_idempotency_key",
    "decided_at"
  ],
  "title": "ApprovalRecord",
  "type": "object"
}
