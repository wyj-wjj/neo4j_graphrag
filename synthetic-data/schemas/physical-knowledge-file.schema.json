{
  "additionalProperties": false,
  "properties": {
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "const": "synthetic-commerce-v1",
      "title": "Dataset Version",
      "type": "string"
    },
    "document_id": {
      "title": "Document Id",
      "type": "string"
    },
    "evidence_anchor_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Evidence Anchor Id"
    },
    "expected_outcome": {
      "enum": [
        "parse_success",
        "ocr_success",
        "reject_corrupt"
      ],
      "title": "Expected Outcome",
      "type": "string"
    },
    "format": {
      "enum": [
        "md",
        "txt",
        "html",
        "pdf",
        "docx",
        "xlsx",
        "pptx",
        "png",
        "jpeg"
      ],
      "title": "Format",
      "type": "string"
    },
    "is_synthetic": {
      "const": true,
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "mime_type": {
      "title": "Mime Type",
      "type": "string"
    },
    "physical_file_id": {
      "title": "Physical File Id",
      "type": "string"
    },
    "relative_path": {
      "title": "Relative Path",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "synthetic-record-v1",
      "default": "synthetic-record-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 1,
      "title": "Size Bytes",
      "type": "integer"
    },
    "source": {
      "const": "fake",
      "default": "fake",
      "title": "Source",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^synthetic-[a-z0-9-]+$",
      "title": "Tenant Id",
      "type": "string"
    },
    "variant": {
      "enum": [
        "normal",
        "boundary",
        "corrupt"
      ],
      "title": "Variant",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "scenario_id",
    "tenant_id",
    "physical_file_id",
    "document_id",
    "evidence_anchor_id",
    "format",
    "variant",
    "relative_path",
    "mime_type",
    "size_bytes",
    "content_sha256",
    "expected_outcome"
  ],
  "title": "PhysicalKnowledgeFileRecord",
  "type": "object"
}
