{
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "currency": {
      "const": "CNY",
      "default": "CNY",
      "title": "Currency",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "const": "synthetic-commerce-v1",
      "title": "Dataset Version",
      "type": "string"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "is_synthetic": {
      "const": true,
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "max_refundable_amount": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
          "type": "string"
        }
      ],
      "title": "Max Refundable Amount"
    },
    "order_id": {
      "title": "Order Id",
      "type": "string"
    },
    "order_snapshot_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Order Snapshot Hash",
      "type": "string"
    },
    "refund_id": {
      "title": "Refund Id",
      "type": "string"
    },
    "requested_amount": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
          "type": "string"
        }
      ],
      "title": "Requested Amount"
    },
    "requested_by": {
      "title": "Requested By",
      "type": "string"
    },
    "requires_approval": {
      "title": "Requires Approval",
      "type": "boolean"
    },
    "risk_level": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Risk Level",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "synthetic-record-v1",
      "default": "synthetic-record-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "const": "fake",
      "default": "fake",
      "title": "Source",
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "approval_pending",
        "approved",
        "rejected",
        "expired",
        "reconciled",
        "compensation_required"
      ],
      "title": "Status",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^synthetic-[a-z0-9-]+$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "scenario_id",
    "tenant_id",
    "refund_id",
    "order_id",
    "requested_by",
    "requested_amount",
    "max_refundable_amount",
    "risk_level",
    "requires_approval",
    "status",
    "idempotency_key",
    "order_snapshot_hash",
    "created_at"
  ],
  "title": "RefundRecord",
  "type": "object"
}
