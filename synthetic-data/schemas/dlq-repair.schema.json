      "const": 0,
      "default": 0,
      "title": "Expected Duplicate Side Effect Count",
      "type": "integer"
    },
    "expected_replay_result": {
      "const": "accepted",
      "default": "accepted",
      "title": "Expected Replay Result",
      "type": "string"
    },
    "failure_kind": {
      "enum": [
        "poison",
        "unknown_schema"
      ],
      "title": "Failure Kind",
      "type": "string"
    },
    "failure_reason": {
      "title": "Failure Reason",
      "type": "string"
    },
    "is_synthetic": {
      "const": true,
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "operator_role": {
      "const": "supervisor",
      "default": "supervisor",
      "title": "Operator Role",
      "type": "string"
    },
    "operator_user_id": {
      "title": "Operator User Id",
      "type": "string"
    },
    "oracle_version": {
      "title": "Oracle Version",
      "type": "string"
    },
    "original_payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Original Payload Hash",
      "type": "string"
    },
    "repair_id": {
      "title": "Repair Id",
      "type": "string"
    },
    "repair_version": {
      "const": 1,
      "default": 1,
      "title": "Repair Version",
      "type": "integer"
    },
    "replay_audit_id": {
      "title": "Replay Audit Id",
      "type": "string"
    },
    "replay_id": {
      "title": "Replay Id",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "synthetic-record-v1",
      "default": "synthetic-record-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "const": "fake",
      "default": "fake",
      "title": "Source",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^synthetic-[a-z0-9-]+$",
      "title": "Tenant Id",
      "type": "string"
    }
