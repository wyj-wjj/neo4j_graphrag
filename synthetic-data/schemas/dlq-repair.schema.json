  "required": [
    "dataset_id",
    "dataset_version",
    "scenario_id",
    "tenant_id",
    "repair_id",
    "delivery_id",
    "original_payload_hash",
    "failure_kind",
    "failure_reason",
    "operator_user_id",
    "replay_id",
    "replay_audit_id",
