{
  "additionalProperties": false,
  "properties": {
    "active": {
      "default": true,
      "title": "Active",
      "type": "boolean"
    },
    "dataset_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "const": "synthetic-commerce-v1",
      "title": "Dataset Version",
      "type": "string"
    },
    "department_id": {
      "title": "Department Id",
      "type": "string"
    },
    "display_name": {
      "title": "Display Name",
      "type": "string"
    },
    "email": {
      "pattern": "^[a-z0-9._-]+@[a-z0-9-]+\\.invalid$",
      "title": "Email",
      "type": "string"
    },
    "is_synthetic": {
      "const": true,
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "masked_phone": {
      "const": "000-0000-0000",
      "default": "000-0000-0000",
      "title": "Masked Phone",
      "type": "string"
    },
    "region": {
      "const": "测试省-演示市",
      "default": "测试省-演示市",
      "title": "Region",
      "type": "string"
    },
    "role": {
      "enum": [
        "customer",
        "customer_service",
        "supervisor",
        "knowledge_admin",
        "auditor",
        "tenant_admin"
      ],
      "title": "Role",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "synthetic-record-v1",
      "default": "synthetic-record-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "const": "fake",
      "default": "fake",
      "title": "Source",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^synthetic-[a-z0-9-]+$",
      "title": "Tenant Id",
      "type": "string"
    },
    "user_id": {
      "title": "User Id",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "scenario_id",
    "tenant_id",
    "user_id",
    "display_name",
    "email",
    "role",
    "department_id"
  ],
  "title": "UserRecord",
  "type": "object"
}
