{
  "additionalProperties": false,
  "properties": {
    "actor_user_id": {
      "title": "Actor User Id",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "const": "synthetic-commerce-v1",
      "title": "Dataset Version",
      "type": "string"
    },
    "decision_id": {
      "title": "Decision Id",
      "type": "string"
    },
    "dependency_available": {
      "title": "Dependency Available",
      "type": "boolean"
    },
    "expected_allowed": {
      "title": "Expected Allowed",
      "type": "boolean"
    },
    "explicit_deny": {
      "title": "Explicit Deny",
      "type": "boolean"
    },
    "is_synthetic": {
      "const": true,
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "reason_code": {
      "enum": [
        "owner_allowed",
        "role_allowed",
        "explicit_deny",
        "cross_tenant",
        "missing_policy",
        "dependency_unavailable"
      ],
      "title": "Reason Code",
      "type": "string"
    },
    "relation": {
      "enum": [
        "owner",
        "department",
        "tenant_role",
        "cross_tenant",
        "missing_policy"
      ],
      "title": "Relation",
      "type": "string"
    },
    "resource_id": {
      "title": "Resource Id",
      "type": "string"
    },
    "resource_tenant_id": {
      "title": "Resource Tenant Id",
      "type": "string"
    },
    "resource_type": {
      "enum": [
        "order",
        "knowledge",
        "approval",
        "audit"
      ],
      "title": "Resource Type",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "synthetic-record-v1",
      "default": "synthetic-record-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "const": "fake",
      "default": "fake",
      "title": "Source",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^synthetic-[a-z0-9-]+$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "scenario_id",
    "tenant_id",
    "decision_id",
    "actor_user_id",
    "resource_type",
    "resource_id",
    "resource_tenant_id",
    "relation",
    "explicit_deny",
    "dependency_available",
    "expected_allowed",
    "reason_code"
  ],
  "title": "AccessDecisionRecord",
  "type": "object"
}
