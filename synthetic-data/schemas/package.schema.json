{
  "$defs": {
    "TrackingPoint": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "state": {
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "occurred_at",
        "location",
        "detail"
      ],
      "title": "TrackingPoint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "carrier": {
      "title": "Carrier",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "const": "synthetic-commerce-v1",
      "title": "Dataset Version",
      "type": "string"
    },
    "is_synthetic": {
      "const": true,
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "line_quantities": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Line Quantities",
      "type": "object"
    },
    "order_id": {
      "title": "Order Id",
      "type": "string"
    },
    "package_id": {
      "title": "Package Id",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "synthetic-record-v1",
      "default": "synthetic-record-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "const": "fake",
      "default": "fake",
      "title": "Source",
      "type": "string"
    },
    "status": {
      "enum": [
        "label_created",
        "picked_up",
        "in_transit",
        "exception",
        "out_for_delivery",
        "delivered",
        "returned"
      ],
      "title": "Status",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^synthetic-[a-z0-9-]+$",
      "title": "Tenant Id",
      "type": "string"
    },
    "tracking_events": {
      "items": {
        "$ref": "#/$defs/TrackingPoint"
      },
      "minItems": 1,
      "title": "Tracking Events",
      "type": "array"
    },
    "tracking_number": {
      "title": "Tracking Number",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "scenario_id",
    "tenant_id",
    "package_id",
    "order_id",
    "tracking_number",
    "carrier",
    "status",
    "line_quantities",
    "tracking_events"
  ],
  "title": "PackageRecord",
  "type": "object"
}
