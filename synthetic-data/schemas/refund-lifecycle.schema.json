{
  "additionalProperties": false,
  "properties": {
    "approval_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Approval Id"
    },
    "attempt_kind": {
      "enum": [
        "first",
        "idempotent_replay",
        "payload_conflict",
        "unknown_result",
        "reconciled",
        "compensation",
        "compensation_failed"
      ],
      "title": "Attempt Kind",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "const": "synthetic-commerce-v1",
      "title": "Dataset Version",
      "type": "string"
    },
    "expected_error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expected Error Code"
    },
    "expected_side_effect_count": {
      "maximum": 1,
      "minimum": 0,
      "title": "Expected Side Effect Count",
      "type": "integer"
    },
    "expected_status": {
      "enum": [
        "blocked",
        "pending",
        "executed",
        "unknown",
        "reconciled",
        "compensated",
        "manual_intervention"
      ],
      "title": "Expected Status",
      "type": "string"
    },
    "is_synthetic": {
      "const": true,
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "lifecycle_id": {
      "title": "Lifecycle Id",
      "type": "string"
    },
    "oracle_version": {
      "title": "Oracle Version",
      "type": "string"
    },
    "refund_id": {
      "title": "Refund Id",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "synthetic-record-v1",
      "default": "synthetic-record-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "const": "fake",
      "default": "fake",
      "title": "Source",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^synthetic-[a-z0-9-]+$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "scenario_id",
    "tenant_id",
    "lifecycle_id",
    "refund_id",
    "approval_id",
    "attempt_kind",
    "expected_status",
    "expected_side_effect_count",
    "expected_error_code",
    "oracle_version"
  ],
  "title": "RefundLifecycleRecord",
  "type": "object"
}
