{
  "additionalProperties": false,
  "properties": {
    "actor_user_id": {
      "title": "Actor User Id",
      "type": "string"
    },
    "address_requires_approval": {
      "title": "Address Requires Approval",
      "type": "boolean"
    },
    "dataset_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "const": "synthetic-commerce-v1",
      "title": "Dataset Version",
      "type": "string"
    },
    "expected_allowed": {
      "title": "Expected Allowed",
      "type": "boolean"
    },
    "expected_error_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Expected Error Code"
    },
    "is_synthetic": {
      "const": true,
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "max_refundable_amount": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,2}0*$",
          "type": "string"
        }
      ],
      "title": "Max Refundable Amount"
    },
    "operation": {
      "enum": [
        "view",
        "update_address",
        "calculate_refund"
      ],
      "title": "Operation",
      "type": "string"
    },
    "oracle_case_id": {
      "title": "Oracle Case Id",
      "type": "string"
    },
    "oracle_version": {
      "title": "Oracle Version",
      "type": "string"
    },
    "order_id": {
      "title": "Order Id",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "synthetic-record-v1",
      "default": "synthetic-record-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "const": "fake",
      "default": "fake",
      "title": "Source",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^synthetic-[a-z0-9-]+$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "scenario_id",
    "tenant_id",
    "oracle_case_id",
    "actor_user_id",
    "order_id",
    "operation",
    "expected_allowed",
    "expected_error_code",
    "address_requires_approval",
    "max_refundable_amount",
    "oracle_version"
  ],
  "title": "OrderOracleRecord",
  "type": "object"
}
