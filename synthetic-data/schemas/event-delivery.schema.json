{
  "additionalProperties": false,
  "properties": {
    "dataset_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "const": "synthetic-commerce-v1",
      "title": "Dataset Version",
      "type": "string"
    },
    "delivered_at": {
      "format": "date-time",
      "title": "Delivered At",
      "type": "string"
    },
    "delivery_id": {
      "title": "Delivery Id",
      "type": "string"
    },
    "delivery_kind": {
      "enum": [
        "normal",
        "duplicate",
        "out_of_order",
        "poison",
        "unknown_schema"
      ],
      "title": "Delivery Kind",
      "type": "string"
    },
    "delivery_ordinal": {
      "minimum": 1,
      "title": "Delivery Ordinal",
      "type": "integer"
    },
    "event_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Event Id"
    },
    "expected_route": {
      "enum": [
        "inbox",
        "duplicate_ignored",
        "dlq"
      ],
      "title": "Expected Route",
      "type": "string"
    },
    "is_synthetic": {
      "const": true,
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Payload Hash",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "synthetic-record-v1",
      "default": "synthetic-record-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "const": "fake",
      "default": "fake",
      "title": "Source",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^synthetic-[a-z0-9-]+$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "scenario_id",
    "tenant_id",
    "delivery_id",
    "event_id",
    "delivery_ordinal",
    "delivery_kind",
    "delivered_at",
    "expected_route",
    "payload_hash",
    "payload"
  ],
  "title": "EventDeliveryRecord",
  "type": "object"
}
