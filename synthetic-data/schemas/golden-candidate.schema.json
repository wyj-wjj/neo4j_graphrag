{
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "const": "synthetic-commerce-v1",
      "title": "Dataset Version",
      "type": "string"
    },
    "evaluation_case_id": {
      "title": "Evaluation Case Id",
      "type": "string"
    },
    "evidence_anchor_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Anchor Ids",
      "type": "array"
    },
    "expected_behavior": {
      "title": "Expected Behavior",
      "type": "string"
    },
    "fact_record_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Fact Record Ids",
      "type": "array"
    },
    "is_synthetic": {
      "const": true,
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "promotion_eligible": {
      "const": false,
      "default": false,
      "title": "Promotion Eligible",
      "type": "boolean"
    },
    "quality_tier": {
      "const": "golden_candidate",
      "default": "golden_candidate",
      "title": "Quality Tier",
      "type": "string"
    },
    "required_independent_reviewers": {
      "const": 2,
      "default": 2,
      "title": "Required Independent Reviewers",
      "type": "integer"
    },
    "review_checklist": {
      "items": {
        "type": "string"
      },
      "minItems": 4,
      "title": "Review Checklist",
      "type": "array"
    },
    "review_status": {
      "const": "pending_independent_review",
      "default": "pending_independent_review",
      "title": "Review Status",
      "type": "string"
    },
    "reviewed_at": {
      "default": null,
      "title": "Reviewed At",
      "type": "null"
    },
    "reviewer_id": {
      "default": null,
      "title": "Reviewer Id",
      "type": "null"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "synthetic-record-v1",
      "default": "synthetic-record-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "const": "fake",
      "default": "fake",
      "title": "Source",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^synthetic-[a-z0-9-]+$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "scenario_id",
    "tenant_id",
    "candidate_id",
    "evaluation_case_id",
    "fact_record_ids",
    "evidence_anchor_ids",
    "expected_behavior",
    "review_checklist"
  ],
  "title": "GoldenCandidateRecord",
  "type": "object"
}
