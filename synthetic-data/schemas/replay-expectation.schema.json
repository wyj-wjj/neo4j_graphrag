{
  "additionalProperties": false,
  "properties": {
    "aggregate_id": {
      "title": "Aggregate Id",
      "type": "string"
    },
    "aggregate_type": {
      "enum": [
        "order",
        "package",
        "refund",
        "knowledge",
        "conversation",
        "dataset"
      ],
      "title": "Aggregate Type",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "const": "synthetic-commerce-v1",
      "title": "Dataset Version",
      "type": "string"
    },
    "expected_dlq_events": {
      "minimum": 0,
      "title": "Expected Dlq Events",
      "type": "integer"
    },
    "expected_duplicate_events": {
      "minimum": 0,
      "title": "Expected Duplicate Events",
      "type": "integer"
    },
    "expected_terminal_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Expected Terminal Hash",
      "type": "string"
    },
    "expected_unique_events": {
      "minimum": 0,
      "title": "Expected Unique Events",
      "type": "integer"
    },
    "is_synthetic": {
      "const": true,
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "oracle_version": {
      "title": "Oracle Version",
      "type": "string"
    },
    "replay_id": {
      "title": "Replay Id",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "synthetic-record-v1",
      "default": "synthetic-record-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "const": "fake",
      "default": "fake",
      "title": "Source",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^synthetic-[a-z0-9-]+$",
      "title": "Tenant Id",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "scenario_id",
    "tenant_id",
    "replay_id",
    "aggregate_type",
    "aggregate_id",
    "expected_unique_events",
    "expected_duplicate_events",
    "expected_dlq_events",
    "expected_terminal_hash",
    "oracle_version"
  ],
  "title": "ReplayExpectationRecord",
  "type": "object"
}
