{
  "additionalProperties": false,
  "properties": {
    "allowed_side_effects": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Side Effects",
      "type": "array"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "context_policy_version": {
      "const": "context-policy-v1",
      "default": "context-policy-v1",
      "title": "Context Policy Version",
      "type": "string"
    },
    "conversation_id": {
      "title": "Conversation Id",
      "type": "string"
    },
    "dataset_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Dataset Id",
      "type": "string"
    },
    "dataset_version": {
      "const": "synthetic-commerce-v1",
      "title": "Dataset Version",
      "type": "string"
    },
    "event_schema_version": {
      "const": "event-envelope-v1",
      "default": "event-envelope-v1",
      "title": "Event Schema Version",
      "type": "string"
    },
    "evidence_anchor_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Anchor Ids",
      "type": "array"
    },
    "expected_agents": {
      "items": {
        "type": "string"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Expected Agents",
      "type": "array"
    },
    "expected_answer_status": {
      "enum": [
        "answered",
        "refused",
        "clarification",
        "escalated",
        "fake_result"
      ],
      "title": "Expected Answer Status",
      "type": "string"
    },
    "expected_intent": {
      "title": "Expected Intent",
      "type": "string"
    },
    "expected_tool_order": {
      "items": {
        "type": "string"
      },
      "title": "Expected Tool Order",
      "type": "array"
    },
    "forbidden_side_effects": {
      "items": {
        "type": "string"
      },
      "title": "Forbidden Side Effects",
      "type": "array"
    },
    "is_synthetic": {
      "const": true,
      "default": true,
      "title": "Is Synthetic",
      "type": "boolean"
    },
    "model_profile": {
      "const": "fake-model-profile-v1",
      "default": "fake-model-profile-v1",
      "title": "Model Profile",
      "type": "string"
    },
    "oracle_version": {
      "title": "Oracle Version",
      "type": "string"
    },
    "prompt_version": {
      "const": "synthetic-prompt-v1",
      "default": "synthetic-prompt-v1",
      "title": "Prompt Version",
      "type": "string"
    },
    "quality_tier": {
      "const": "silver",
      "default": "silver",
      "title": "Quality Tier",
      "type": "string"
    },
    "router_version": {
      "const": "synthetic-router-v1",
      "default": "synthetic-router-v1",
      "title": "Router Version",
      "type": "string"
    },
    "scenario_id": {
      "maxLength": 160,
      "minLength": 8,
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "synthetic-record-v1",
      "default": "synthetic-record-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "const": "fake",
      "default": "fake",
      "title": "Source",
      "type": "string"
    },
    "split": {
      "enum": [
        "train",
        "dev",
        "test",
        "holdout"
      ],
      "title": "Split",
      "type": "string"
    },
    "state_schema_version": {
      "const": "agent-state-v1",
      "default": "agent-state-v1",
      "title": "State Schema Version",
      "type": "string"
    },
    "tenant_id": {
      "pattern": "^synthetic-[a-z0-9-]+$",
      "title": "Tenant Id",
      "type": "string"
    },
    "tool_schema_versions": {
      "items": {
        "type": "string"
      },
      "title": "Tool Schema Versions",
      "type": "array"
    }
  },
  "required": [
    "dataset_id",
    "dataset_version",
    "scenario_id",
    "tenant_id",
    "case_id",
    "conversation_id",
    "split",
    "expected_intent",
    "expected_agents",
    "expected_tool_order",
    "evidence_anchor_ids",
    "allowed_side_effects",
    "forbidden_side_effects",
    "expected_answer_status",
    "oracle_version",
    "tool_schema_versions"
  ],
  "title": "EvaluationCaseRecord",
  "type": "object"
}
