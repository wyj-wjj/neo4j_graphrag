# =============================================
# 1. Neo4j 数据库配置 (Docker 部署)
# =============================================
NEO4J_URI=neo4j://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# =============================================
# 2. MySQL 数据库配置 (宝塔裸机部署)
# =============================================
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/enterprise_agent_db

# =============================================
# 3. Milvus 向量数据库配置 (Docker 部署)
# =============================================
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=weview_content_chunks

# =============================================
# 4. Redis 配置 (Docker 部署, 阶段一必填)
# =============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# =============================================
# 5. Kafka 消息队列 (Docker 部署, 阶段二启用)
# =============================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_KNOWLEDGE_EVENTS=knowledge.events
KAFKA_TOPIC_AGENT_EVENTS=agent.events
KAFKA_TOPIC_ACTION_EVENTS=action.events

# =============================================
# 6. 阿里百炼 LLM 配置 (多模型级联)
# =============================================
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# L3 旗舰模型
DASHSCOPE_CHAT_MODEL=qwen-plus
# L2 小模型
DASHSCOPE_SMALL_MODEL=qwen-turbo
# Embedding 模型
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
# OCR & Vision 模型
DASHSCOPE_OCR_MODEL=qwen-vl-ocr-2025-11-20
DASHSCOPE_VISION_MODEL=qwen3.6-plus
# 结构化抽取 & 试题生成
DASHSCOPE_STRUCTURE_MODEL=qwen-plus
DASHSCOPE_QUIZ_MODEL=qwen-plus

# =============================================
# 7. RAG 检索参数
# =============================================
RAG_SIMILARITY_THRESHOLD=0.7
RAG_TOP_K=5

# =============================================
# 8. JWT 认证
# =============================================
JWT_SECRET_KEY=replace-with-a-secure-random-secret-of-32-plus-chars

# =============================================
# 9. 超时配置
# =============================================
DASHSCOPE_HTTP_TIMEOUT_SECONDS=15
DASHSCOPE_IMPORT_TIMEOUT_SECONDS=120
DASHSCOPE_OCR_TIMEOUT_SECONDS=60
DASHSCOPE_QUIZ_TIMEOUT_SECONDS=90

# =============================================
# 10. 外部依赖开关 (阶段一用 Fake, 阶段二接真实服务)
# =============================================
USE_FAKE_EXTERNAL_CLIENTS=false

# =============================================
# 11. 前端配置
# =============================================
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8000

# =============================================
# 12. langfuse
# =============================================
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
