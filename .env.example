# Runtime
APP_ENV=dev
APP_NAME=Neo4j GraphRAG Agent
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=default
USE_FAKE_EXTERNAL_CLIENTS=true

# Authentication: dev/test only. Production must use JWT_JWKS_URL.
JWT_ALGORITHM=HS256
JWT_DEV_SECRET=replace-with-a-local-random-value
JWT_ISSUER=neo4j-graphrag-local
JWT_AUDIENCE=neo4j-graphrag-api
JWT_JWKS_URL=

# MySQL application account; never use root.
DATABASE_URL=mysql+aiomysql://app_user:replace-me@127.0.0.1:3306/enterprise_agent_db
DATABASE_POOL_SIZE=10

# Docker Compose-only bootstrap values; replace all values before starting services.
MYSQL_APP_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-me
REDIS_PASSWORD=replace-me
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me

# Redis / Milvus / Neo4j
REDIS_URL=redis://:replace-me@127.0.0.1:6379/0
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=weview_content_chunks_v1
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-me
NEO4J_DATABASE=neo4j

# Alibaba Bailian OpenAI-compatible API
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
ROUTER_MODEL=qwen-turbo
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_VERSION=v1
RERANK_MODEL=qwen3-rerank
RERANK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_ENABLED=true
OCR_MODEL=qwen-vl-ocr-2025-11-20

# Retrieval and ingestion
RAG_RETRIEVAL_TOP_K=20
RAG_FINAL_TOP_K=5
RAG_RRF_K=60
RAG_GRAPH_MAX_HOPS=2
RAG_MIN_RERANK_SCORE=0.08
RAG_RERANK_RELATIVE_THRESHOLD=0.80
FAQ_SIMILARITY_THRESHOLD=0.88
ROUTER_CONFIDENCE_THRESHOLD=0.75
CHUNK_TARGET_CHARS=450
CHUNK_MAX_CHARS=600
CHUNK_OVERLAP_RATIO=0.12
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=26214400
UPLOAD_MAX_PAGES=200
ALLOWED_UPLOAD_TYPES=.pdf,.docx,.xlsx,.pptx,.html,.htm,.txt,.md,.png,.jpg,.jpeg
INGESTION_CONCURRENCY=2
EMBEDDING_BATCH_SIZE=16

# Timeouts and state
DEPENDENCY_TIMEOUT_SECONDS=5
ROUTER_TIMEOUT_SECONDS=8
GENERATION_TIMEOUT_SECONDS=60
EMBEDDING_TIMEOUT_SECONDS=30
RERANK_TIMEOUT_SECONDS=15
OCR_PAGE_TIMEOUT_SECONDS=60
TOOL_TIMEOUT_SECONDS=10
CHECKPOINT_TTL_SECONDS=86400
CHAT_RATE_LIMIT_PER_MINUTE=30
UPLOAD_RATE_LIMIT_PER_MINUTE=10
FAKE_APPROVAL_SECRET=

# Observability: disabled unless explicitly enabled.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=
