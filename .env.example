# Runtime
APP_ENV=dev
APP_NAME=Neo4j GraphRAG Agent
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=default
USE_FAKE_EXTERNAL_CLIENTS=true

# Authentication: dev/test only. Production must use JWT_JWKS_URL.
JWT_ALGORITHM=HS256
JWT_DEV_SECRET=replace-with-a-local-random-value
JWT_ISSUER=neo4j-graphrag-local
JWT_AUDIENCE=neo4j-graphrag-api
JWT_JWKS_URL=

# MySQL application account; never use root.
DATABASE_URL=mysql+aiomysql://app_user:replace-me@127.0.0.1:3306/enterprise_agent_db
DATABASE_POOL_SIZE=10

# Docker Compose-only bootstrap values; replace all values before starting services.
MYSQL_APP_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-me
REDIS_PASSWORD=replace-me
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me
OBJECT_STORE_ACCESS_KEY=replace-me
OBJECT_STORE_SECRET_KEY=replace-me

# Redis / Milvus / Neo4j
REDIS_URL=redis://:replace-me@127.0.0.1:6379/0
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=weview_content_chunks_v1
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-me
NEO4J_DATABASE=neo4j

# Phase 2 Kafka Outbox Relay. Keep disabled until the broker is configured.
KAFKA_ENABLED=false
OUTBOX_RELAY_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_CLIENT_ID=neo4j-graphrag-outbox
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_KNOWLEDGE_TOPIC=knowledge.events.v1
KAFKA_ACTION_TOPIC=action.events.v1
KAFKA_PUBLISH_TIMEOUT_SECONDS=10
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_SECONDS=30
OUTBOX_POLL_INTERVAL_SECONDS=0.5
OUTBOX_RETRY_BASE_SECONDS=1
OUTBOX_RETRY_MAX_SECONDS=300
KAFKA_MAX_EVENT_BYTES=1048576
KAFKA_VECTOR_CONSUMER_GROUP=graphrag-vector-index-v1
KAFKA_GRAPH_CONSUMER_GROUP=graphrag-graph-index-v1
KAFKA_METADATA_TIMEOUT_SECONDS=5
KAFKA_CONSUMER_POLL_TIMEOUT_SECONDS=1
KAFKA_CONSUMER_RETRY_PAUSE_SECONDS=1
INBOX_LEASE_SECONDS=180
CONSUMER_HANDLER_TIMEOUT_SECONDS=120
CONSUMER_MAX_ATTEMPTS=5
CONSUMER_RETRY_BASE_SECONDS=1
CONSUMER_RETRY_MAX_SECONDS=300

# Alibaba Bailian OpenAI-compatible API
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
ROUTER_MODEL=qwen-turbo
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024
EMBEDDING_VERSION=v1
RERANK_MODEL=qwen3-rerank
RERANK_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_ENABLED=true
OCR_MODEL=qwen-vl-ocr-2025-11-20

# Retrieval and ingestion
RAG_RETRIEVAL_TOP_K=20
RAG_FINAL_TOP_K=5
RAG_RRF_K=60
RAG_GRAPH_MAX_HOPS=2
RAG_MIN_RERANK_SCORE=0.08
RAG_RERANK_RELATIVE_THRESHOLD=0.80
FAQ_SIMILARITY_THRESHOLD=0.88
ROUTER_CONFIDENCE_THRESHOLD=0.75
CHUNK_TARGET_CHARS=450
CHUNK_MAX_CHARS=600
CHUNK_OVERLAP_RATIO=0.12
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_BYTES=26214400
UPLOAD_MAX_PAGES=200
ALLOWED_UPLOAD_TYPES=.pdf,.docx,.xlsx,.pptx,.html,.htm,.txt,.md,.png,.jpg,.jpeg
INGESTION_CONCURRENCY=2
EMBEDDING_BATCH_SIZE=16

# Original knowledge files. Production must use an isolated S3-compatible bucket.
OBJECT_STORE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=false
S3_VERIFY_TLS=true
S3_SSE_ALGORITHM=
S3_KMS_KEY_ID=

# The repository-provided HTTP simulator is dev/test only, never a production adapter.
BUSINESS_ADAPTER_MODE=fake
SYNTHETIC_BUSINESS_BASE_URL=
BUSINESS_TIMEOUT_SECONDS=5
BUSINESS_READ_MAX_ATTEMPTS=2

# Timeouts and state
DEPENDENCY_TIMEOUT_SECONDS=5
ROUTER_TIMEOUT_SECONDS=8
GENERATION_TIMEOUT_SECONDS=60
EMBEDDING_TIMEOUT_SECONDS=30
RERANK_TIMEOUT_SECONDS=15
OCR_PAGE_TIMEOUT_SECONDS=60
TOOL_TIMEOUT_SECONDS=10
CHECKPOINT_TTL_SECONDS=86400
# context-policy-v1 starting point: 30% recent, 20% memory, 40% evidence, 10% fixed.
CONTEXT_POLICY_VERSION=context-policy-v1
MODEL_CONTEXT_WINDOW_TOKENS=32768
CONTEXT_RESERVED_OUTPUT_TOKENS=4096
CONTEXT_RECENT_HISTORY_RATIO=0.30
CONTEXT_WORKING_MEMORY_RATIO=0.20
CONTEXT_EXTERNAL_EVIDENCE_RATIO=0.40
CONTEXT_FIXED_RATIO=0.10
CONTEXT_SUMMARY_TRIGGER_TOKENS=6000
CONTEXT_SUMMARY_MAX_TOKENS=1500
LONG_TERM_MEMORY_AUTO_WRITE_ENABLED=false
CHAT_RATE_LIMIT_PER_MINUTE=30
UPLOAD_RATE_LIMIT_PER_MINUTE=10
FAKE_APPROVAL_SECRET=

# Observability: disabled unless explicitly enabled.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
OTEL_EXPORTER_OTLP_ENDPOINT=
